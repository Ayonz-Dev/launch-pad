{
  "name": "launch-pad",
  "private": true,
  "version": "0.1.0",
  "description": "Ayonz internal platform. A monorepo home for internal apps that share one identity, RBAC and database layer.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:costing": "npm run dev --workspace @launchpad/costing",
    "dev:hedging": "npm run dev --workspace @launchpad/hedging",
    "build": "npm run build --workspaces --if-present",
    "build:costing": "npm run build --workspace @launchpad/costing",
    "build:hedging": "npm run build --workspace @launchpad/hedging",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "@supabase/supabase-js": "2.45.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
