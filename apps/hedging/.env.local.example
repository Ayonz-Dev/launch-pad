# Canonical shared Ayonz Supabase project (same as costing and shipping).
# https://jhhorikmpftvzlawcuty.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://jhhorikmpftvzlawcuty.supabase.co

# Anon key: used by the shared login and the session gate (middleware). When
# both URL and anon key are set, the login gate is active. Leave them unset to
# run on bundled sample data with no login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: dashboard reads (coverage, cash, forwards, and the shipping
# visibility schema). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
