# Supabase connection for the FX engine dashboard.
# The project URL, shown in Supabase under Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# One key is enough. Use the service-role key for server-side reads, or the
# anon key if your RLS policies allow reading the coverage and cash views.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
