# ---- Google Maps (client-side, optional) ----
# Create a key at https://console.cloud.google.com/google/maps-apis
# Enable "Maps JavaScript API". Restrict the key to your Vercel domain.
# Leave blank to use free OpenStreetMap tiles (no Google billing).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Data source switch ----
# "mock" (default) runs entirely on bundled sample data — no external calls, no cost.
# "supabase" reads live shipments from the shared Ayonz Supabase project.
DATA_SOURCE=mock

# ---- Canonical shared Supabase project (same as costing-app) ----
# https://jhhorikmpftvzlawcuty.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://jhhorikmpftvzlawcuty.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key — used by import / ingest / manage writes (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Which Postgres schema the app reads/writes:
#   "public"     — pre-migration live table (default; what you're on today).
#   "visibility" — org-scoped, RLS-protected target. Switch to this ONLY after
#                  applying both migrations, exposing the schema in Data API, and
#                  running costing-app /setup. See "Cutover to visibility" in README.
SUPABASE_DB_SCHEMA=public
# Org UUID created when you run costing-app /setup. Required once SUPABASE_DB_SCHEMA=visibility.
VISIBILITY_ORGANIZATION_ID=

# ---- Ingest webhook auth ----
# Shared secret a carrier push must send as `x-ingest-token`.
INGEST_TOKEN=change-me

# ---- Alibaba sourcing pipeline (Stage 01) ----
# Run: npm run sourcing:run   (see scripts/sourcing/README.md)
# Defaults to the same canonical project as shipments. Override only if sourcing
# tables are intentionally hosted elsewhere:
SOURCING_SUPABASE_URL=https://jhhorikmpftvzlawcuty.supabase.co
SOURCING_SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback if service role not set:
# SOURCING_SUPABASE_ANON_KEY=
# Provider key (Omkar free tier):
SOURCING_PROVIDER_API_KEY=
# Optional alias:
# OMKAR_API_KEY=
# Defaults target Omkar free tier:
# SOURCING_PROVIDER_BASE_URL=https://alibaba-scraper.omkar.cloud
# SOURCING_SEARCH_PATH=/alibaba/products/search
# SOURCING_PRODUCT_PATH=/alibaba/products/details
# SOURCING_API_KEY_HEADER=API-Key

# ---- Monday product catalogue mirror (server-only) ----
# Personal API token; never prefix with NEXT_PUBLIC_.
MONDAY_API_TOKEN=
MONDAY_ARTWORK_BOARD_ID=659128200
MONDAY_COMPLETED_ARTWORK_BOARD_ID=660792519
MONDAY_SOCIAL_MEDIA_BOARD_ID=3738736764
# Optional: pin a supported Monday API version.
# MONDAY_API_VERSION=
# Optional: simultaneous Supabase writes (default 8, maximum 16).
# MONDAY_SYNC_CONCURRENCY=8
# Legacy compatibility: MONDAY_PRODUCTS_BOARD_ID is accepted as the completed
# artwork board when MONDAY_COMPLETED_ARTWORK_BOARD_ID is not set.


# ---- Shareable view links (Manage → Generate link) ----
# Requires the share_views table: run supabase/share_views.sql in the SQL Editor.
# Links look like /v/{id} and set an httpOnly cookie that filters + optionally
# redacts costs across the read-only app.

# ---- Manage (edit UI / import) auth ----
# Preferred: short PIN sent as `x-manage-pin` from Import + Manage screens.
MANAGE_PIN=
# Optional legacy long secret (`x-manage-token`). Either PIN or token unlocks writes.
# Leave both blank to allow unauthenticated writes (local only).
MANAGE_TOKEN=

# ---- AISStream (server-only) ----
# Live vessel positions via wss://stream.aisstream.io/v0/stream
# Never expose this to the client (NEXT_PUBLIC_*). Get a key at https://aisstream.io/
AISSTREAM_API_KEY=
